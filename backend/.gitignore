# ═══════════════════════════════════════════════════
# Grosirun Backend — Laravel .gitignore
# ═══════════════════════════════════════════════════

# ─── Composer ───
/vendor/

# ─── Environment ───
.env
.env.backup
.env.production

# ─── Laravel Storage ───
/storage/*.key
/storage/app/public/
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/data/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/framework/testing/.gitkeep
!/storage/logs/.gitkeep
!/storage/app/public/.gitkeep

# ─── Node / Vite ───
/node_modules/
/public/build
/public/hot
/public/storage
/public/mix-manifest.json
/resources/js/bootstrap.js.bak
npm-debug.log
yarn-error.log

# ─── PHP / Testing ───
.phpunit.result.cache
.phpunit.cache/
.phpunit.cache/test-results
coverage/
*.cache

# ─── IDE / Editor ───
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.buildpath
nbproject/

# ─── OS ───
.DS_Store
Thumbs.db
Desktop.ini

# ─── Sentry / Debug ───
.sentryclirc

# ─── Backup ───
*.sql
*.sql.gz
backup/

# ─── Misc ───
Homestead.yaml
Homestead.json
*.pem
*.log
