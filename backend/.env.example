APP_NAME=Grosirun
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grosirun
DB_USERNAME=grosirun
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@grosirun.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=grosirun-prod-private
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3 Configuration
FILESYSTEM_DISK=s3
AWS_S3_ENDPOINT=
AWS_S3_CDN_URL=

# Firebase Configuration
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
FCM_SENDER_ID=
FCM_SERVER_KEY=

# WA Gateway (Fonnte)
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate Limiting
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_OTP=5
RATE_LIMIT_OVERRIDE=10

# Sanctum Token Expiry (days)
SANCTUM_TOKEN_EXPIRY_DAYS=30

# Storage Configuration
STORAGE_DISK=s3
PROOF_MAX_SIZE=2048
CAMPAIGN_IMAGE_MAX_SIZE=5120
IMAGE_COMPRESS_QUALITY=70
PROOF_RETENTION_DAYS=90

# Backup Configuration
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=7
